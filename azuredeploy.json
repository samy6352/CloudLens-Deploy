      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "B3",
        "S1",
        "P0v3",
        "P1v3"
      ],
      "metadata": {
        "description": "App Service plan size. B1 is the smallest with Always On, which scheduled loads need."
      }
